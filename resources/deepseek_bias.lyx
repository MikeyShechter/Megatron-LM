\begin_layout Standard
Learn routing bias params (like DeepSeek):
\begin_inset Formula 
\[
(b_{1},\ldots,b_{E})=b
\]

\end_inset


\end_layout

\begin_layout Standard
Input token 
\begin_inset Formula $x^{(t)}$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
R(x^{(t)})=(r_{1,}^{(t)}\ldots,r_{E}^{(t)})=r^{(t)}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
(p_{1}^{(t)},\ldots,p_{E}^{(t)})=\text{activation}(r^{(t)})
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{\partial\text{IndTopK}(p^{(t)}+b)_{e}}{\partial b_{i}}\approx\frac{1}{h}\text{Rect}\!\left(\frac{p_{e}^{(t)}+b_{e}-m(p^{(t)}+b)}{h}\right)\frac{\partial}{\partial b_{i}}\left(p_{e}^{(t)}+b_{e}-m(p^{(t)}+b)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
So
\begin_inset Formula 
\[
\frac{\partial f_{e}}{\partial b_{i}}\approx\frac{1}{T}\sum_{t=1}^{T}\frac{1}{h}\text{Rect}\!\left(\frac{p_{e}^{(t)}+b_{e}-m(p^{(t)}+b)}{h}\right)\frac{\partial}{\partial b_{i}}\left(p_{e}^{(t)}+b_{e}-m(p^{(t)}+b)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
And the Direct Load Blanace loss is:
\begin_inset Formula 
\[
\frac{\partial L_{\mathrm{DLB}}}{\partial b_{i}}\approx\frac{2\alpha E}{T}\sum_{e=1}^{E}\left(f_{e}-\frac{K}{E}\right)\sum_{t=1}^{T}\frac{1}{h}\text{Rect}\!\left(\frac{p_{e}^{(t)}+b_{e}-m(p^{(t)}+b)}{h}\right)\frac{\partial}{\partial b_{i}}\left(p_{e}^{(t)}+b_{e}-m(p^{(t)}+b)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
With respect to the other model params it's the same
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\nabla_{\theta}L_{\mathrm{DLB}}\approx\frac{2\alpha E}{T}\sum_{e=1}^{E}\left(f_{e}-\frac{K}{E}\right)\sum_{t=1}^{T}\frac{1}{h}\text{Rect}\!\left(\frac{p_{e}^{(t)}+b_{e}-m(r^{(t)}+b)}{h}\right)\nabla_{\theta}\left(p_{e}^{(t)}+b_{e}-m(p^{(t)}+b)\right)
\]

\end_inset


\end_layout

